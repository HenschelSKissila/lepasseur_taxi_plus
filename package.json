{
  "name": "le-passeur-taxi-plus",
  "private": true,
  "version": "2.4.0",
  "description": "Gestion de flotte de taxis : recettes, dépenses, chauffeurs, salaires, amortissement et retour sur investissement (FCFA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:sql": "node tests/schema.test.mjs supabase/migrations/20261119000000_schema_initial.sql",
    "build:local": "tsc -b && vite build --mode horsserveur"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
